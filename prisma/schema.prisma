generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Phase 1: catalogue ----------

model Subject {
  id           String   @id @default(cuid())
  code         String?
  name         String
  campus       String
  faculty      String?
  ubcSubjectId String
  courses      Course[]

  @@unique([ubcSubjectId, campus])
  @@index([code])
}

model Course {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  number      String
  title       String
  description String?
  credits     Float?
  campus      String
  prereqText  String?
  coreqText   String?
  /** Requirement tree parsed from prereqText - see src/prereqs/parse.ts. */
  prereqTree  Json?
  /** Requirement tree parsed from coreqText - same shape as prereqTree. */
  coreqTree   Json?
  /** Resolved-or-not course refs from "Equivalency:" clauses - see
    * src/prereqs/parse.ts:extractAntireqCodes. Same array shape a flat
    * Requirement course list would use: {code, courseId}[]. */
  antireqCodes Json?
  updatedAt   DateTime @updatedAt
  sections    Section[]
  gradeDistributions GradeDistribution[]
  transferCredits    TransferCredit[]
  historicalGrades       CourseHistoricalGrades?
  historicalGradesByTerm CourseHistoricalGradesByTerm[]
  prereqEdgesFrom        CoursePrereqEdge[] @relation("PrereqEdgeFrom")
  prereqEdgesTo          CoursePrereqEdge[] @relation("PrereqEdgeTo")

  @@unique([subjectId, number])
}

model Term {
  id          String    @id @default(cuid())
  ubcPeriodId String    @unique
  name        String
  year        Int
  session     String
  termNumber  Int?
  campus      String
  startDate   DateTime?
  endDate     DateTime?
  sections    Section[]
}

model Section {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  termId       String
  term         Term     @relation(fields: [termId], references: [id])
  sectionCode  String
  activity     String?
  status       String?
  deliveryMode String?
  enrolTotal   Int?
  enrolCap     Int?
  meetingTimes MeetingTime[]
  instructors  SectionInstructor[]

  @@unique([courseId, termId, sectionCode])
}

model MeetingTime {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  day       String
  startTime String?
  endTime   String?
  building  String?
  room      String?
  startDate DateTime?
  endDate   DateTime?

  /// Course pages include meetingTimes via sectionId IN (...); 36k rows with
  /// no index made that a sequential scan per view.
  @@index([sectionId])
}

model Instructor {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  campus   String?
  sections SectionInstructor[]
  gradeDistributions GradeDistributionInstructor[]
}

model SectionInstructor {
  sectionId    String
  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  @@id([sectionId, instructorId])

  /// The professor page filters by instructorId; the PK leads on sectionId,
  /// so without this every professor view walks the whole table.
  @@index([instructorId])
}

// ---------- Later phases: created, unpopulated ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  program       String?
  gradYear      Int?
  createdAt     DateTime @default(now())
  studentIdHash String?   @unique
  verifiedAt    DateTime?
  /// Consecutive failed password attempts since the last success. At the
  /// threshold in authorize-credentials.ts the account locks briefly -
  /// credential stuffing pays bcrypt cost 12 per guess otherwise unbounded.
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  /// Chosen sky/theme mode, so it follows the account across devices.
  /// Null means never chosen - the app falls back to campus weather.
  themeMode     String?
  /// Fixed-window counter for the syllabus-extraction cost guard (see
  /// src/app/api/syllabus/extract/route.ts) - resets once
  /// extractionWindowStart is more than 24h old. Fixed, not sliding: the
  /// window starts at whichever request lands first after expiry, so e.g. 8
  /// calls at t+23:59 and 8 more at t+24:01 is possible. Bounded, and not
  /// worth a real sliding window for an abuse guard. Two plain columns
  /// rather than a new table: one user, one active window, nothing to join.
  extractionCount       Int       @default(0)
  extractionWindowStart DateTime?
  /// The same fixed-window counter, for syllabus UPLOADS (see
  /// src/app/api/syllabus/route.ts). Separate columns from the extraction
  /// pair on purpose: the two quotas bound different costs (billed blob
  /// write operations vs. Anthropic calls) and must not consume each other.
  uploadCount           Int       @default(0)
  uploadWindowStart     DateTime?
  /// When this account last tried to connect a Canvas feed. Connecting fires
  /// a 20 second fetch at canvas.ubc.ca and signup is open, so it is stamped
  /// and tested in one conditional updateMany (see src/canvas/connect.ts).
  /// One column, not a window pair: the cap is one attempt, not a count.
  canvasConnectAttemptAt DateTime?
  enrollments   Enrollment[]
  enrollmentMeetings EnrollmentMeeting[]
  courseReviews CourseReview[]
  instructorReviews InstructorReview[]
  schedules SavedSchedule[]
  enrollmentCalendarTokens EnrollmentCalendarToken[]
  enrollmentShareTokens EnrollmentShareToken[]
  reviewVotes ReviewVote[]
  transferCredits TransferCredit[]
  syllabi Syllabus[]
  assessments SyllabusAssessment[]
  hiddenFinalExams HiddenFinalExam[]
  canvasFeed         CanvasFeed?
  canvasDeadlines    CanvasDeadline[]
  reminderPreference ReminderPreference?
  todos              Todo[]
}

model Enrollment {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  /// Null for a course imported from the academic record: that export lists
  /// what you took and what you got, with no dates and no sections, so there
  /// is no term to record. Nothing that matters for past coursework - the
  /// review gate, degree progress - needs one; only the calendar does, and a
  /// finished course has nothing to draw.
  termId   String?
  source   String
  verified Boolean @default(false)
  /**
   * The grade as Workday reported it - a percentage, a letter, "CR", "TR".
   * Kept verbatim rather than normalised, because the meanings differ by
   * grading basis and the raw value is what a student recognises.
   */
  grade    String?
  /**
   * What this row means for a degree: "registered" (in progress or unknown),
   * "passed", "failed", or "transfer".
   *
   * Registration alone never implied completion, but with no grade column
   * there was nothing better to go on, so guidance inferred "passed" from the
   * term having finished - and told anyone who failed or withdrew that they
   * were done. Defaults to "registered" so existing rows keep their old,
   * honest meaning instead of being silently promoted.
   */
  status   String  @default("registered")

  @@unique([userId, courseId, termId])
}

/**
 * One row per meeting pattern parsed straight from a Workday export's
 * "Meeting Patterns" cell (see src/upload/parse-workday.ts) - the real
 * weekly day/time data Enrollment itself doesn't carry. A course with a
 * lecture + lab produces two rows; re-uploading replaces a (user, course,
 * term)'s rows wholesale rather than merging, since a dropped/changed
 * section should not leave a stale meeting behind.
 */
/**
 * Credit earned at another institution.
 *
 * It cannot live in Enrollment, which is keyed on a UBC term: transfer credit
 * has no term, and often no course either - a Workday record lists rows like
 * "PHYS_V 1ST", unassigned first-year credit in a subject rather than a
 * specific course. Those still count toward a degree's credit total, so
 * `courseId` is optional and `raw` always holds what Workday actually said.
 *
 * Stored, counted toward degree progress, and never a basis for reviewing
 * UBC's version of the course - the review gate reads Enrollment, which these
 * rows are deliberately not part of.
 */
model TransferCredit {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Set when the listing resolves to a real UBC course; null for unassigned credit. */
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])
  /** The Course Listing cell verbatim, e.g. "PHYS_V 1ST - PHYS_V1ST". */
  raw      String
  credits  Float?

  @@unique([userId, raw])
  @@index([userId])
}

model EnrollmentMeeting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  termId      String
  sectionCode String?
  activity    String?
  building    String?
  room        String?
  /// Parsed out of the Workday meeting pattern since day one and thrown away
  /// until now: "CIRS 1250" is easier to find as "CIRS, Floor 2, Room 1250".
  floor       String?
  days        String[]
  startTime   String?
  endTime     String?
  /** Blank on most lab/tutorial rows - Workday only names the lecture's instructor. */
  instructor  String?
  /** The section's own Start/End Date columns - spans every meeting block. */
  startDate   DateTime?
  endDate     DateTime?

  @@index([userId, termId])
}

model CourseReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  termId        String?
  liked         Boolean?
  useful        Int?
  difficulty    Int?
  workloadHours Int?
  text          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, courseId])
}

model InstructorReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorId String
  courseId     String
  liked        Boolean?
  clear        Int?
  engaging     Int?
  text         String?
  createdAt    DateTime @default(now())

  @@unique([userId, instructorId, courseId])
}

/**
 * "This review was helpful", from one student on one review. Anonymous in the
 * same sense reviews are: the row records who so a vote can be taken back and
 * counted once, and nothing but the total is ever rendered.
 *
 * reviewId points at either CourseReview.id or InstructorReview.id - cuids, so
 * unique across both - with `kind` naming which, following the raw-FK
 * convention the rest of the cross-domain joins use.
 */
model ReviewVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  /** 'course' | 'instructor' */
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
}

model SavedSchedule {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId   String
  name     String
  sections ScheduleSection[]
  token    CalendarToken?
  /**
   * Read-only web sharing. Null means not shared, which is the default -
   * sharing is something you turn on, never a side effect of saving.
   *
   * Deliberately NOT the CalendarToken: that one is subscribed inside someone
   * else's calendar app, so revoking web sharing would silently break their
   * feed. Separate tokens mean "stop showing this page" and "stop updating
   * that subscription" are separate decisions.
   */
  shareToken String?          @unique

  @@index([userId])
}

model ScheduleSection {
  scheduleId String
  schedule   SavedSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sectionId  String
  /**
   * Where the class actually meets. Kept HERE rather than read back from the
   * section, because the catalogue has no room at all - UBC's course API
   * exposes no location (see upload/match-schedule), so a student's own
   * Workday export is the only source there has ever been. Without these the
   * import's rooms survived only until the schedule was saved, and reloading
   * showed a timetable with nowhere to go.
   *
   * Null for a section added by hand from the catalogue, which never had one.
   */
  building   String?
  room       String?

  @@id([scheduleId, sectionId])
}

model CalendarToken {
  id         String        @id @default(cuid())
  scheduleId String        @unique
  schedule   SavedSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  token      String        @unique
  createdAt  DateTime      @default(now())
}

/**
 * Capability for the live ICS feed of a student's Workday-imported courses in
 * one term - the enrollment counterpart to CalendarToken, which is scoped to a
 * SavedSchedule. One token per (user, term) so a student can subscribe each
 * term separately and the URL stays stable across re-uploads.
 */
model EnrollmentCalendarToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId    String
  token     String   @unique
  createdAt DateTime @default(now())

  @@unique([userId, termId])
}

/**
 * Read-only web sharing for one term's Workday-imported calendar - the
 * enrollment counterpart to SavedSchedule.shareToken. A separate token from
 * EnrollmentCalendarToken for the same reason that one is separate from
 * CalendarToken: the web page and the subscribed feed revoke independently.
 * Revoking deletes the row; enabling again mints a fresh token.
 */
model EnrollmentShareToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId    String
  token     String   @unique
  createdAt DateTime @default(now())

  @@unique([userId, termId])
}

model GradeDistribution {
  id           String  @id @default(cuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /**
   * NOT NULL via a string default, since Prisma rejects a nullable field in
   * a compound-key where clause. The ingest job always sets this explicitly
   * - the real Term id when one matches (year, session, campus), or
   * "unmatched-<year><session>" when our Term catalogue doesn't cover that
   * period (it only tracks current/near-term periods, not history) - never
   * this bare "" default, which exists only as the column's safety net.
   */
  termId       String  @default("")
  sectionCode  String
  /** "" when the source's Detail column is blank - see note above. */
  detail       String  @default("")
  average      Float?
  median       Float?
  high         Float?
  low          Float?
  count        Int?
  distribution Json?

  instructors GradeDistributionInstructor[]

  @@unique([courseId, termId, sectionCode, detail])
  @@index([courseId])
}

// A section has ONE distribution but may be CO-TAUGHT - verified in real data
// (7 of 127 CPSC 2025W rows list several professors). Duplicating the
// distribution per instructor would inflate every course average.
model GradeDistributionInstructor {
  distributionId String
  distribution   GradeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor        @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([distributionId, instructorId])
  @@index([instructorId])
}

model CourseHistoricalGrades {
  courseId          String   @id
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  average           Float?
  averagePast5Years Float?
  minSectionAverage Float?
  maxSectionAverage Float?
  stddev            Float?
  updatedAt         DateTime @updatedAt
}

// One row per term the course was offered, average computed from
// ubcgrades.com's per-term grade-bucket distribution (a different endpoint
// and bucket format than CourseHistoricalGrades' summary stats above - see
// src/grades/jobs/ingest-historical.ts). Powers the course page's grade
// timeline chart.
model CourseHistoricalGradesByTerm {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  year      Int
  session   String
  average   Float?
  updatedAt DateTime @updatedAt

  @@unique([courseId, year, session])
  @@index([courseId])
}

// Reverse index for "leads to": which courses require courseId as a
// prerequisite. Built during enrich:prereqs's existing tree-walk (Task 2),
// not computed by scanning prereqTree JSON at page-render time.
model CoursePrereqEdge {
  courseId         String
  course           Course  @relation("PrereqEdgeFrom", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourseId String
  requiredCourse   Course  @relation("PrereqEdgeTo", fields: [requiredCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, requiredCourseId])
  @@index([requiredCourseId])
}

model FinalExam {
  id          String   @id @default(cuid())
  courseId    String
  termId      String
  /// "901" from "AMNE_V 101.901", "B_941" from "FNH_V 497.B_941". Not numeric.
  sectionCode String
  /// Null ONLY on a cancelled exam, which the table publishes with empty date,
  /// time and location cells - see §4. Never null on a live exam.
  date        DateTime?
  /// "08:30". The published table gives a start only - see §4 on duration.
  startTime   String?
  /// Surname range, e.g. "ADI-SUN". Empty for most exams; when UBC splits a
  /// course across rooms it is the ONLY thing distinguishing two rows, which
  /// is why it is part of the unique key rather than a display detail.
  alphaSplit  String?
  /// Null for "SEE PROF" and other non-room sentinels - see §4.
  building    String?
  room        String?
  /// Registrar annotations, verbatim: "Late Request", "Location Change (was
  /// DMP 201)", "Cancelled: August 17 2026, 3:30pm". Always displayed as-is.
  notes       String?
  /// Derived from `notes` beginning with "Cancelled" - see §4. A cancelled
  /// exam is kept, never deleted: a student who remembers seeing it needs to
  /// be told it is off, and a row that vanishes tells them nothing.
  cancelled   Boolean  @default(false)

  @@unique([courseId, termId, sectionCode, alphaSplit])
  @@index([termId])
}

/**
 * A student's own syllabus for one course in one term, recorded any of three
 * ways, which are NOT mutually exclusive: an uploaded PDF, a link, or the
 * syllabus pasted as plain text. A row always carries at least one of the
 * three; the upload route refuses to create an empty one.
 *
 * Some UBC syllabi live on a Canvas page behind login and have no file to
 * upload at all, which is why the last two exist: the link is a bookmark,
 * and the pasted text is what makes extraction possible for those courses.
 *
 * `pathname` is the blob's pathname, never a URL, the store is private, so
 * there is no directly-fetchable URL. The only reader is the authenticated
 * streaming route at src/app/api/syllabus/[id]/file/route.ts, which
 * re-checks ownership before calling get().
 *
 * courseId/termId are raw FKs with no Prisma relation, same convention as
 * FinalExam above.
 */
model Syllabus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  termId    String
  /// The three file fields move together: all set when there is an uploaded
  /// PDF, all null when the syllabus was recorded as a link or pasted text.
  pathname  String?
  filename  String?
  size      Int?
  /// Where the syllabus lives when it is not downloadable, typically a Canvas
  /// page. A BOOKMARK ONLY: this is never fetched server-side (it would
  /// return a login page for anything on Canvas, and fetching arbitrary
  /// user-supplied URLs from our server is not something we do). Validated
  /// http/https only by validateSyllabusUrl in src/syllabus/validate.ts.
  url       String?
  /// The syllabus pasted as plain text, for a course whose syllabus cannot be
  /// downloaded. This is the only thing that makes extraction work for those
  /// courses; a url alone cannot be extracted. Length-capped on write, see
  /// MAX_SYLLABUS_TEXT_CHARS.
  sourceText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Null until a student has confirmed and saved an extraction at least
  /// once (set by the save route, not the extract route - see
  /// src/app/api/syllabus/[id]/assessments/route.ts). Doubles as "not yet
  /// read, offer a retry" in the UI when extraction has failed or never run.
  extractedAt DateTime?
  assessments SyllabusAssessment[]

  @@unique([userId, courseId, termId])
}

/**
 * One graded item, either read out of a Syllabus by src/syllabus/extract.ts
 * or typed in by the student, shown on the confirm screen before anything is
 * saved (see src/components/AssessmentConfirm.tsx). On an extracted row
 * `quote`/`page` are the verbatim evidence the student checks against the PDF
 * - the only verification this design has, so both stay visible wherever such
 * a row is shown.
 */
model SyllabusAssessment {
  id         String   @id @default(cuid())
  /// Null on a row the student added straight from the exam view, for a course
  /// they never recorded a syllabus for. Set on everything that came off a
  /// syllabus, which still deletes with it.
  syllabusId String?
  syllabus   Syllabus? @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  /// Whose row this is. The syllabus used to be the only path back to the
  /// student, which meant an exam could not exist without one. These three
  /// are set on every row, syllabus-derived or not, so the exam views can ask
  /// for a student's term directly and a standalone row has a real owner.
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  termId     String
  title      String
  /// "midterm" | "final" | "assignment" | "quiz"
  kind       String
  date       DateTime?
  startTime  String?
  /// Percent of the final grade, when the syllabus states one.
  weight     Float?
  /// Where it is written, verbatim, on a row the student typed. A syllabus
  /// extraction never fills this in: the model reports no location.
  location   String?
  /// Verbatim syllabus text the model based this row on, shown to the student
  /// on the confirm screen. An extracted row is never saved without a human
  /// seeing this.
  ///
  /// NULL, with a NULL page, on a row the student typed in themselves: there
  /// is no syllabus sentence to quote, and the student is the evidence. Only
  /// that origin may leave it null; normalizeSavedAssessment
  /// (src/syllabus/schema.ts) still requires a quote of everything else.
  quote      String?
  page       Int?
  /// True once the student has edited the row, and always true on a row they
  /// added by hand. Read by mergeExams (src/schedule/exams.ts), where it
  /// keeps a final on the page beside UBC's scraped FinalExam for the same
  /// course; an untouched syllabus final is dropped in favour of UBC's.
  /// Nothing ever displaces the scraped row.
  ///
  /// It does NOT survive a re-extraction: saving
  /// (src/app/api/syllabus/[id]/assessments/route.ts) deletes every row for
  /// the syllabus and recreates them from the payload, so re-running the
  /// extract and saving replaces an edited row with the model's version.
  /// That is no longer silent: the confirm screen
  /// (src/components/AssessmentConfirm.tsx) counts the edited rows and asks
  /// before it re-reads, and offers editing the saved rows in place instead,
  /// which is the path that costs no extraction call.
  editedByUser Boolean @default(false)

  @@index([syllabusId])
  /// The exam views ask for one student's term, with no syllabus to join
  /// through - a standalone row has none.
  @@index([userId, termId])
}

/**
 * "Don't show me this one." A FinalExam row is scraped from UBC's public table
 * and shared by everyone in the course, so removing one from a student's exam
 * view cannot delete it - that would take the exam off every classmate's page
 * too. This marks it hidden for ONE student instead.
 *
 * Reversible by deleting the row, which is the whole reason it is a marker
 * rather than a delete: a student who hides their real final by accident has
 * to be able to bring it back, and the exam view lists what they have hidden.
 *
 * finalExamId is a raw FK with no Prisma relation, the same convention
 * FinalExam's own courseId/termId use.
 */
model HiddenFinalExam {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalExamId String
  createdAt   DateTime @default(now())

  @@id([userId, finalExamId])
}

/// One table for every emailed single-use link, discriminated by `purpose`.
///
/// The discriminator is a security control, not bookkeeping. Without it a
/// signup verification link - 24 hours long, and printed to the server console
/// by the current mail transport - could be pasted into /reset and used to set
/// a new password on that account. Every consumer must pass the purpose it
/// expects; see consumeToken in src/lib/mail.ts.
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  /// "verify" (email confirmation) or "reset" (password reset).
  purpose   String   @default("verify")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, purpose])
}

/// One per student: the encrypted Canvas calendar feed URL and its health.
/// The URL is a bearer credential for the student's whole calendar. It is
/// never stored in the clear, never logged, and never sent to the browser.
model CanvasFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM, base64 of iv || tag || ciphertext. See src/canvas/crypto.ts.
  encryptedUrl  String
  connectedAt   DateTime  @default(now())
  /// The last read that actually produced deadlines, not the last attempt:
  /// the page shows it as "last read", so a failing feed must not claim to
  /// be fresh. failureCount is what says the latest attempt failed.
  lastFetchedAt DateTime?
  /// HTTP status of the last fetch, or 0 when nothing usable came back (a
  /// network failure, or a 200 whose body was not a calendar); null before
  /// the first.
  lastStatus    Int?
  /// Consecutive non-200 fetches. Three in a row marks the feed broken.
  failureCount  Int       @default(0)
  /// Set when polling was suspended (401, 404, or three failures). The student
  /// is emailed once. Cleared on reconnect.
  brokenAt      DateTime?
  /// Set once the first sync has run: its welcome email goes out exactly once
  /// and per-item reminders start only after it.
  firstSyncedAt DateTime?
}

/// One per student per Canvas event UID. Two students in one course each hold
/// their own copy: per-section overrides and mutes differ.
model CanvasDeadline {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Canvas's own VEVENT UID, stable across polls; the diff key.
  uid         String
  /// "assignment" when the UID contains that word, else "event".
  kind        String
  /// The SUMMARY with its trailing "[Course]" removed.
  title       String
  /// The bracketed course name from the SUMMARY, verbatim.
  courseName  String
  /// The instant it is due, UTC. An all-day item is 23:59:59 Vancouver on
  /// that date, so "due Friday" reminds before Friday ends.
  dueAt       DateTime
  allDay      Boolean   @default(false)
  url         String?
  firstSeenAt DateTime  @default(now())
  /// Set when a poll found a different dueAt. Kept, not cleared: the sent-log's
  /// notice key stops the notice repeating, and the page shows the move.
  movedFrom   DateTime?
  movedAt     DateTime?
  /// Set when a poll no longer returned this uid. Kept and marked, never
  /// deleted: a prof deleting an assignment is a fact worth showing.
  removedAt   DateTime?
  /// Ticked off by the student, never by a poll. A done deadline stops
  /// generating notices of any kind, including "moved" and "removed": the
  /// work is handed in, so what the professor does to the date afterwards is
  /// not news worth an email.
  completedAt DateTime?
  /// Set when the student put this deadline on their todo board, cleared when
  /// they take it off. The board holds a reference rather than a copy, so a
  /// title or date the professor changes still reaches it.
  onBoardAt   DateTime?
  /// Where the student dragged this row on the board. Null means they never
  /// moved it, and the board's default order decides where it sits. See
  /// compareBoardItems in src/canvas/todos.ts.
  boardOrder  Int?
  /// The student's own jot on the board row ("start this today"). Never
  /// touched by a poll, so it survives Canvas changing the title or date.
  note        String?
  reminders   ReminderSent[]

  @@unique([userId, uid])
  @@index([userId, dueAt])
}

/// One thing the student wrote on their todo board: the work that has no
/// Canvas assignment behind it and no due date worth reminding against.
///
/// There is deliberately no week column. The board shows unfinished todos
/// plus whatever was finished since Monday, so an unfinished item rolls over
/// by simply never leaving, and a finished one drops off when the week turns.
/// A stored week would need a job to advance it, and a job that did not run
/// is a board that is silently wrong.
model Todo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  createdAt   DateTime  @default(now())
  /// Ticked off by the student. Null is what keeps it on the board.
  completedAt DateTime?
  /// Where the student dragged this row. Null means never moved; the board's
  /// default order decides. Same column and same rule as CanvasDeadline's,
  /// because the board sorts both kinds through one comparator.
  boardOrder  Int?
  /// Same as CanvasDeadline.note: a jot under the title, null when empty.
  note        String?

  @@index([userId])
}

model ReminderPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(true)
  /// Hours before dueAt at which to remind. Default 3 days and 1 day.
  leadHours    Int[]    @default([72, 24])
  /// Course names, as they appear in the feed's brackets, the student muted.
  mutedCourses String[] @default([])
}

/// The no-double-send guarantee. A row is claimed BEFORE the email is sent;
/// the unique below means two overlapping runs cannot both send. A row with
/// null deliveredAt is a claim whose send failed, retried next run.
model ReminderSent {
  id          String         @id @default(cuid())
  userId      String
  deadlineId  String
  deadline    CanvasDeadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  /// "lead:72:<dueAt ISO>", "lead:24:<dueAt ISO>", "moved:<new dueAt ISO>",
  /// "removed". The due date is in the lead key so that a deadline the prof
  /// moves earns a fresh claim, instead of the spent claim for the old date
  /// blocking the reminder for the new one.
  notice      String
  claimedAt   DateTime       @default(now())
  deliveredAt DateTime?

  @@unique([deadlineId, notice])
  @@index([userId, deliveredAt])
}

/// One row per kind of error that has alerted, so the fifteen-minute cooldown
/// on alert emails is shared by every server instance instead of each holding
/// its own timer in memory.
///
/// The memory version looked fine at one instance and fell apart at several:
/// errors coming from five deployments at once each got a fresh timer, so
/// twelve errors in a day sent roughly twelve emails. Keyed per error rather
/// than globally, so a noisy one cannot mute a new and different one.
model ErrorAlert {
  /// The error's digest when it has one, else its message. Its identity.
  key        String   @id
  lastSentAt DateTime
  /// How many of this error have happened since the last email went out, so
  /// the next one can say how much it is standing in for. Reading an inbox
  /// should not be how you estimate volume.
  suppressed Int      @default(0)
}

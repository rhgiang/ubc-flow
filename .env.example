DATABASE_URL="postgresql://user:pass@localhost:5442/ubcflow"
SERVER_SECRET="generate-with-openssl-rand-hex-32"
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# openssl rand -hex 32 -- encrypts stored Canvas feed URLs (src/canvas/crypto.ts).
FEED_ENCRYPTION_KEY=

# Public origin of the deployment. Verification and password-reset emails are
# built from this (src/app/actions/auth.ts, password-reset.ts) — leave it unset
# in production and every link in them points at the recipient's own machine.
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://<your-domain>/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (resend.com/api-keys) — sends password-reset and verification email.
# Leave unset to fall back to logging mail to the server console instead of
# actually sending it.
RESEND_API_KEY=""
# Must stay onboarding@resend.dev until a domain is verified in the Resend
# dashboard: that test address can only deliver to the email you signed up
# to Resend with, so this needs a verified sending domain before real
# students can receive these.
MAIL_FROM="UBC Flow <onboarding@resend.dev>"

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave it unset and no
# Google script loads and no analytics cookie is set — which is what keeps
# local and preview builds out of the numbers, and out of the privacy policy's
# scope. Analytics/DataStreams in the GA console is where the ID comes from.
NEXT_PUBLIC_GA_ID=""

# Vercel Blob (vercel.com/docs/vercel-blob) — private store used for the
# syllabus locker (src/app/api/syllabus). Create a store in the Vercel
# dashboard's Storage tab and copy its read-write token here.
BLOB_READ_WRITE_TOKEN=

# console.anthropic.com/settings/keys — used by src/syllabus/extract.ts to
# read the assessment list out of an uploaded syllabus PDF. Costs real money
# per call; see the per-user daily cap in src/app/api/syllabus/extract/route.ts.
ANTHROPIC_API_KEY=

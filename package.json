{
  "name": "ubc-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:catalog": "tsx src/scrape/jobs/catalog.run.ts",
    "scrape:sections": "tsx src/scrape/jobs/sections.run.ts",
    "scrape:descriptions": "tsx src/scrape/jobs/descriptions.run.ts",
    "scrape:faculties": "tsx src/scrape/jobs/faculties.run.ts",
    "scrape:courses": "tsx src/scrape/jobs/catalogue-courses.run.ts",
    "guidance:verify": "tsx src/guidance/jobs/verify.run.ts",
    "enrich:prereqs": "tsx src/prereqs/jobs/build.run.ts",
    "scrape:all": "npm run scrape:catalog && npm run scrape:sections && npm run scrape:descriptions && npm run enrich:prereqs",
    "ingest:grades": "tsx src/grades/jobs/ingest.run.ts",
    "ingest:historical-grades": "tsx src/grades/jobs/ingest-historical.run.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

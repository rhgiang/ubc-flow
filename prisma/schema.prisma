generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Phase 1: catalogue ----------

model Subject {
  id           String   @id @default(cuid())
  code         String?
  name         String
  campus       String
  faculty      String?
  ubcSubjectId String
  courses      Course[]

  @@unique([ubcSubjectId, campus])
  @@index([code])
}

model Course {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  number      String
  title       String
  description String?
  credits     Float?
  campus      String
  prereqText  String?
  coreqText   String?
  /** Requirement tree parsed from prereqText — see src/prereqs/parse.ts. */
  prereqTree  Json?
  /** Requirement tree parsed from coreqText — same shape as prereqTree. */
  coreqTree   Json?
  /** Resolved-or-not course refs from "Equivalency:" clauses — see
    * src/prereqs/parse.ts:extractAntireqCodes. Same array shape a flat
    * Requirement course list would use: {code, courseId}[]. */
  antireqCodes Json?
  updatedAt   DateTime @updatedAt
  sections    Section[]
  gradeDistributions GradeDistribution[]
  historicalGrades       CourseHistoricalGrades?
  historicalGradesByTerm CourseHistoricalGradesByTerm[]
  prereqEdgesFrom        CoursePrereqEdge[] @relation("PrereqEdgeFrom")
  prereqEdgesTo          CoursePrereqEdge[] @relation("PrereqEdgeTo")

  @@unique([subjectId, number])
}

model Term {
  id          String    @id @default(cuid())
  ubcPeriodId String    @unique
  name        String
  year        Int
  session     String
  termNumber  Int?
  campus      String
  startDate   DateTime?
  endDate     DateTime?
  sections    Section[]
}

model Section {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  termId       String
  term         Term     @relation(fields: [termId], references: [id])
  sectionCode  String
  activity     String?
  status       String?
  deliveryMode String?
  enrolTotal   Int?
  enrolCap     Int?
  meetingTimes MeetingTime[]
  instructors  SectionInstructor[]

  @@unique([courseId, termId, sectionCode])
}

model MeetingTime {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  day       String
  startTime String?
  endTime   String?
  building  String?
  room      String?
  startDate DateTime?
  endDate   DateTime?
}

model Instructor {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  campus   String?
  sections SectionInstructor[]
  gradeDistributions GradeDistributionInstructor[]
}

model SectionInstructor {
  sectionId    String
  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  @@id([sectionId, instructorId])
}

// ---------- Later phases: created, unpopulated ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  program       String?
  gradYear      Int?
  createdAt     DateTime @default(now())
  studentIdHash String?   @unique
  verifiedAt    DateTime?
  enrollments   Enrollment[]
  enrollmentMeetings EnrollmentMeeting[]
  courseReviews CourseReview[]
  instructorReviews InstructorReview[]
  schedules SavedSchedule[]
}

model Enrollment {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  termId   String
  source   String
  verified Boolean @default(false)

  @@unique([userId, courseId, termId])
}

/**
 * One row per meeting pattern parsed straight from a Workday export's
 * "Meeting Patterns" cell (see src/upload/parse-workday.ts) — the real
 * weekly day/time data Enrollment itself doesn't carry. A course with a
 * lecture + lab produces two rows; re-uploading replaces a (user, course,
 * term)'s rows wholesale rather than merging, since a dropped/changed
 * section should not leave a stale meeting behind.
 */
model EnrollmentMeeting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  termId      String
  sectionCode String?
  activity    String?
  building    String?
  room        String?
  days        String[]
  startTime   String?
  endTime     String?

  @@index([userId, termId])
}

model CourseReview {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  termId        String?
  liked         Boolean?
  useful        Int?
  difficulty    Int?
  workloadHours Int?
  text          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, courseId])
}

model InstructorReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorId String
  courseId     String
  liked        Boolean?
  clear        Int?
  engaging     Int?
  text         String?
  createdAt    DateTime @default(now())

  @@unique([userId, instructorId, courseId])
}

model SavedSchedule {
  id       String            @id @default(cuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId   String
  name     String
  sections ScheduleSection[]
  token    CalendarToken?

  @@index([userId])
}

model ScheduleSection {
  scheduleId String
  schedule   SavedSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sectionId  String

  @@id([scheduleId, sectionId])
}

model CalendarToken {
  id         String        @id @default(cuid())
  scheduleId String        @unique
  schedule   SavedSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  token      String        @unique
  createdAt  DateTime      @default(now())
}

model GradeDistribution {
  id           String  @id @default(cuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /**
   * NOT NULL via a string default, since Prisma rejects a nullable field in
   * a compound-key where clause. The ingest job always sets this explicitly
   * — the real Term id when one matches (year, session, campus), or
   * "unmatched-<year><session>" when our Term catalogue doesn't cover that
   * period (it only tracks current/near-term periods, not history) — never
   * this bare "" default, which exists only as the column's safety net.
   */
  termId       String  @default("")
  sectionCode  String
  /** "" when the source's Detail column is blank — see note above. */
  detail       String  @default("")
  average      Float?
  median       Float?
  high         Float?
  low          Float?
  count        Int?
  distribution Json?

  instructors GradeDistributionInstructor[]

  @@unique([courseId, termId, sectionCode, detail])
  @@index([courseId])
}

// A section has ONE distribution but may be CO-TAUGHT — verified in real data
// (7 of 127 CPSC 2025W rows list several professors). Duplicating the
// distribution per instructor would inflate every course average.
model GradeDistributionInstructor {
  distributionId String
  distribution   GradeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor        @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([distributionId, instructorId])
  @@index([instructorId])
}

model CourseHistoricalGrades {
  courseId          String   @id
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  average           Float?
  averagePast5Years Float?
  minSectionAverage Float?
  maxSectionAverage Float?
  stddev            Float?
  updatedAt         DateTime @updatedAt
}

// One row per term the course was offered, average computed from
// ubcgrades.com's per-term grade-bucket distribution (a different endpoint
// and bucket format than CourseHistoricalGrades' summary stats above — see
// src/grades/jobs/ingest-historical.ts). Powers the course page's grade
// timeline chart.
model CourseHistoricalGradesByTerm {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  year      Int
  session   String
  average   Float?
  updatedAt DateTime @updatedAt

  @@unique([courseId, year, session])
  @@index([courseId])
}

// Reverse index for "leads to": which courses require courseId as a
// prerequisite. Built during enrich:prereqs's existing tree-walk (Task 2),
// not computed by scanning prereqTree JSON at page-render time.
model CoursePrereqEdge {
  courseId         String
  course           Course  @relation("PrereqEdgeFrom", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourseId String
  requiredCourse   Course  @relation("PrereqEdgeTo", fields: [requiredCourseId], references: [id], onDelete: Cascade)

  @@id([courseId, requiredCourseId])
  @@index([requiredCourseId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
